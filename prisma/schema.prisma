// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Proveedor {
  id      String   @id @default(cuid())
  nombre  String   @unique
  activo  Boolean  @default(true)
  prendas Prenda[]
}

// Telas disponibles en casa, para producción. Reemplaza la hoja
// "TELAS EN CASA". `metrajeDisponible` se guarda en su `unidad` original
// (metros o kg); la conversión a metros para cálculos vive en el código.
model Tela {
  id                String    @id @default(cuid())
  nombre            String
  costoPorMetro     Float?
  metrajeDisponible Float     @default(0)
  unidad            String    @default("metros") // "metros" | "kg"
  unidadOriginal    String? // texto libre tal cual se anotó, solo para mostrar
  costoTotal        Float?
  fechaCompra       DateTime?
  fechaEnvio        DateTime?
  estado            String    @default("disponible") // "disponible" | "agotada"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Metros de tela que consume cada talla. Tabla de configuración editable
// (no una fórmula): la relación real no es lineal. Dato inicial para
// algodón/felpa a ~S/16/m.
model ConsumoTalla {
  talla  Int   @id
  metros Float
}

model Prenda {
  id                     String    @id @default(cuid())
  clienteNombre          String
  contacto               String?
  disenoTela             String
  talla                  String?
  tipoPrenda             String
  proveedorId            String
  proveedor              Proveedor @relation(fields: [proveedorId], references: [id])
  estadoFabricacion      String    @default("compra_tela_pendiente")
  estadoPago             String    @default("interesado")
  fechaCompra            DateTime?
  fechaEntregaSolicitada DateTime?
  fechaEnvioReal         DateTime?
  montoPagado            Float?
  nota                   String?
  urgente                Boolean   @default(false)
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
